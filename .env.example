# Postgres (matches docker-compose.yml)
DB_HOST=localhost
DB_PORT=5434
DB_NAME=mindspace
DB_USER=mindspace
DB_PASSWORD=mindspace

# OpenRouter API key (routed via https://openrouter.ai/api/v1, see src/config/constants.ts).
